    <string id="SetCometMode">Comet trail</string>
    <string id="SetCometModePrompt">How the trail behind the second hand is coloured.</string>
    <string id="CometClassic">Classic (one hue)</string>
    <string id="CometSpectrumTrail">Spectrum trail</string>
    <string id="CometSpectrumRing">Spectrum ring</string>

    <string id="SetCometFive">Comet crosses the numerals</string>
    <string id="SetCometFivePrompt">Off, the trail skips the five-second marks so it breaks around the numbers. On, it draws a dot there too and runs unbroken.</string>

    <string id="SetOrbitRing">Show orbit ring</string>
    <string id="SetOrbitRingPrompt">The faint dotted circle inside the hour numerals.</string>

    <string id="SetBackground">Background</string>
    <string id="SetBackgroundPrompt">Random starfield, or the star pattern of a zodiac constellation.</string>
    <string id="BgStarfield">Starfield</string>
    <string id="BgZodiacStars">Zodiac stars</string>
    <string id="BgZodiacLines">Zodiac stars + lines</string>

    <string id="SetZodiacSign">Zodiac sign</string>
    <string id="SetZodiacSignPrompt">Auto follows the current sun sign. Only used when the background is set to a zodiac constellation.</string>
    <string id="ZodiacAuto">Auto (current sun sign)</string>
    <string id="ZodiacAries">Aries</string>
    <string id="ZodiacTaurus">Taurus</string>
    <string id="ZodiacGemini">Gemini</string>
    <string id="ZodiacCancer">Cancer</string>
