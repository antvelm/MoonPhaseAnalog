    <string id="ZodiacCapricornus">Capricornus</string>
    <string id="ZodiacAquarius">Aquarius</string>
    <string id="ZodiacPisces">Pisces</string>

    <string id="SetStarDensity">Star density</string>
    <string id="DensityOff">Off</string>
    <string id="DensitySparse">Sparse</string>
    <string id="DensityNormal">Normal</string>
    <string id="DensityDense">Dense</string>

    <string id="SetShowHours">Show hour numerals</string>
    <string id="SetHourNumeralsOuter">Hour numerals on outer ring</string>
    <string id="SetHourNumeralsOuterPrompt">Moves the hour numerals out to the second track, bigger and upright, in place of the 5-second numerals there.</string>

    <string id="SetHourMarkStyle">Hour mark style</string>
    <string id="SetHourMarkStylePrompt">What the hour positions show: numerals, numerals at 12/3/6/9 with bold ticks elsewhere, or bold ticks only at 12/3/6/9 with thin ticks elsewhere.</string>
    <string id="HourMarkNumerals">Numerals</string>
    <string id="HourMarkLines">Numerals + lines</string>
    <string id="HourMarkLinesCardinal">Lines (12/3/6/9 bold)</string>

    <string id="SetShowSeconds">Show second numerals</string>

    <!-- Rainbow wave -->
    <string id="SetWave">Daily rainbow wave</string>
    <string id="SetWavePrompt">Once a day a band of spectrum washes outward across the face. It runs for about 12 seconds, and fires on the first wrist raise after the set hour.</string>
    <string id="SetWaveHour">Rainbow wave hour</string>

    <!-- Eclipses -->
    <string id="SetEclipse">Eclipse effects</string>
    <string id="SetEclipsePrompt">Turn the moon copper during a lunar eclipse and show a corona during a solar one. Exact eclipse data is built in through 2045; after that the dates are calculated on the watch.</string>

    <string id="SetEclipseVis">Show eclipses</string>
    <string id="SetEclipseVisPrompt">"Only when visible here" uses the last known GPS position to check the eclipsed body is above your horizon. It never needs a GPS fix, and falls back to showing every eclipse when no position is available. For solar eclipses this only confirms the sun is up, not that you are on the path of totality.</string>
    <string id="EclipseAlways">Always</string>
    <string id="EclipseIfHere">Only when visible here</string>

    <string id="SetEclipseSource">Eclipse data</string>
    <string id="SetEclipseSourcePrompt">Built-in data covers 2025 to 2045 exactly. "Always calculate" uses the on-watch astronomy for every date instead, which is also how dates past 2045 are handled.</string>
    <string id="EclipseSrcTable">Built in through 2045</string>
    <string id="EclipseSrcCompute">Always calculate</string>

    <!-- Diagnostics -->
    <string id="ReadOnlyPrompt">Reported by the watch. Anything typed here is overwritten.</string>
    <string id="SetEclipseInfo">Eclipse data status</string>
    <string id="SetLastFix">Last position used</string>

    <!-- Testing -->
    <string id="SetWaveTest">Rainbow wave test mode</string>
    <string id="SetWaveTestPrompt">Fire the wave at the top of every minute instead of once a day.</string>

    <string id="SetDebugEclipse">Force eclipse</string>
    <string id="SetDebugEclipsePrompt">Render an eclipse regardless of the date, for checking how it looks.</string>
    <string id="DebugEclipseOff">Off</string>
    <string id="DebugEclipseLunar">Force lunar</string>
    <string id="DebugEclipseSolar">Force solar</string>

    <string id="SetTimeOffset">Astronomy time offset (days)</string>
    <string id="SetTimeOffsetPrompt">Shifts only the moon and eclipse calculations, so the face keeps showing the real time. Leave at 0 for normal use.</string>

    <string id="SetDebugLat">Test latitude</string>
    <string id="SetDebugLon">Test longitude</string>
    <string id="SetDebugCoordPrompt">Overrides the GPS position for the eclipse visibility check. 999 means unset.</string>
</strings>
